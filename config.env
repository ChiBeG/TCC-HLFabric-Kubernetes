# =====================================================================
# Configuração central do ambiente. Todos os scripts leem este arquivo.
# Altere versões aqui, nunca dentro dos scripts.
# =====================================================================

# --- Rede das VMs (VirtualBox host-only) ---
CP_IP=192.168.56.10
W1_IP=192.168.56.11
W2_IP=192.168.56.12
NODE_IFACE=enp0s8                 # interface da rede privada (não a NAT enp0s3)
POD_CIDR=10.244.0.0/16
METALLB_POOL=192.168.56.200-192.168.56.250
INGRESS_IP=192.168.56.200         # IP fixo do ingress do Istio (usado pelas CAs)

# --- Versões (validadas em set/2026) ---
K8S_MINOR=v1.30
HELM_VERSION=v3.16.4
METALLB_VERSION=v0.14.3
ISTIO_VERSION=1.20.0
HLF_OPERATOR_CHART=1.14.0
HLF_PLUGIN_VERSION=1.14.0
GO_VERSION=1.22.12
NODE_MAJOR=22
CALIPER_VERSION=0.6.0
CALIPER_SUT=fabric:2.4

# --- Imagens do Fabric ---
PEER_IMAGE=hyperledger/fabric-peer
PEER_VERSION=2.5.5
ORDERER_IMAGE=hyperledger/fabric-orderer
ORDERER_VERSION=2.5.5
CA_IMAGE=hyperledger/fabric-ca
CA_VERSION=1.5.7
SC_NAME=local-path

# --- Rede Fabric ---
CANAL=canal-vinculo
CHAINCODE=vinculo
CC_IMAGE=vinculo-cc
CC_TAG=${CC_TAG:-1.0}             # mude ao atualizar o chaincode (ex.: 1.1)
CC_VERSION=${CC_VERSION:-1.0}
CC_SEQUENCE=${CC_SEQUENCE:-1}     # incremente a cada atualização do chaincode
CC_POLICY="OR('Org1MSP.member','Org2MSP.member')"

# --- Monitoramento ---
GRAFANA_ADMIN_PASSWORD=troque-esta-senha
GRAFANA_NODEPORT=30300
PROMETHEUS_NODEPORT=30900
PROMETHEUS_URL=http://192.168.56.10:30900

# --- Credenciais de bootstrap das CAs (ambiente de laboratório) ---
ENROLL_ID=enroll
ENROLL_PW=enrollpw
ADMIN_PW=adminpw
PEER_PW=peerpw
ORDERER_PW=ordererpw
CALIPER_PW=caliperpw

# Pasta compartilhada com o host (Vagrant)
SHARED=/vagrant
ARTIFACTS=/vagrant/artifacts
